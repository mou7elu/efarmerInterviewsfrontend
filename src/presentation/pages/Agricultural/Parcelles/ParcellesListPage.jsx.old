/**
 * Parcelles List Page
 * Page de gestion des parcelles agricoles (CRUD)
 */

import React, { useEffect, useState } from 'react';
import {
  Container,
  Typography,
  Paper,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TablePagination,
  IconButton,
  Button,
  Box,
  TextField,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Grid,
  Card,
  CardContent,
  Fab,
  Tooltip,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
  Chip,
} from '@mui/material';
import {
  Add as AddIcon,
  Edit as EditIcon,
  Delete as DeleteIcon,
  Search as SearchIcon,
  Landscape as LandscapeIcon,
  Agriculture as AgricultureIcon,
  Straighten as StraightenIcon,
  Map as MapIcon,
} from '@mui/icons-material';

import LoadingSpinner from '@presentation/components/Common/LoadingSpinner.jsx';
import GeoJSONInput from '@presentation/components/Common/GeoJSONInput.jsx';
import { parcellesAPI, producteursAPI, handleApiError } from '../../../../services/api.js';

const ParcellesListPage = () => {
  // États locaux
  const [parcelles, setParcelles] = useState([]);
  const [filteredParcelles, setFilteredParcelles] = useState([]);
  const [producteurs, setProducteurs] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(25);
  const [searchTerm, setSearchTerm] = useState('');
  const [producteurFilter, setProducteurFilter] = useState('');
  const [cultureFilter, setCultureFilter] = useState('');
  
  // Types de cultures
  const typesCulture = [
    'Cacao',
    'Café',
    'Anacarde (Cajou)',
    'Hévéa',
    'Palmier à huile',
    'Riz',
    'Maïs',
    'Manioc',
    'Igname',
    'Banane plantain',
    'Autre',
  ];
  
  // États pour les modals
  const [createDialogOpen, setCreateDialogOpen] = useState(false);
  const [editDialogOpen, setEditDialogOpen] = useState(false);
  const [deleteDialogOpen, setDeleteDialogOpen] = useState(false);
  const [selectedParcelle, setSelectedParcelle] = useState(null);
  
  // États pour le formulaire
  const [formData, setFormData] = useState({
    code: '',
    culture: '',
    superficie: '',
    producteurId: '',
    coordonnees: null,
  });

  useEffect(() => {
    loadData();
    loadProducteurs();
  }, []);

  // Appliquer les filtres
  useEffect(() => {
    if (!searchTerm && !producteurFilter && !cultureFilter) {
      setFilteredParcelles(parcelles);
    } else {
      const filtered = parcelles.filter(p => {
        const code = p.code || '';
        const culture = p.culture || '';
        
        const producteurMatch = !producteurFilter || p.producteurId === producteurFilter;
        const cultureMatch = !cultureFilter || culture === cultureFilter;
        const searchMatch = !searchTerm || 
          code.toLowerCase().includes(searchTerm.toLowerCase()) ||
          culture.toLowerCase().includes(searchTerm.toLowerCase());
        
        return searchMatch && producteurMatch && cultureMatch;
      });
      setFilteredParcelles(filtered);
    }
    setPage(0);
  }, [parcelles, searchTerm, producteurFilter, cultureFilter]);

  const loadData = async () => {
    try {
      setLoading(true);
      setError('');
      
      const response = await parcellesAPI.getAll({ limit: 200 });
      const data = response.data || response;
      const parcellesData = data.items || data || [];
      
      setParcelles(parcellesData);
      setFilteredParcelles(parcellesData);
    } catch (error) {
      console.error('Erreur lors du chargement:', error);
      setError(handleApiError(error));
    } finally {
      setLoading(false);
    }
  };

  const loadProducteurs = async () => {
    try {
      const response = await producteursAPI.getAll({ limit: 200 });
      const data = response.data || response;
      const producteursData = data.items || data || [];
      setProducteurs(producteursData);
    } catch (error) {
      console.error('Erreur lors du chargement des producteurs:', error);
    }
  };

  // Calcul automatique de la superficie à partir du polygon GeoJSON
  const calculateSuperficie = (geojson) => {
    if (!geojson || geojson.type !== 'Polygon' || !geojson.coordinates || !geojson.coordinates[0]) {
      return 0;
    }

    // Fonction pour calculer la superficie d'un polygone en hectares
    // Utilise la formule de Shoelace (coordonnées géographiques)
    const coords = geojson.coordinates[0];
    let area = 0;

    for (let i = 0; i < coords.length - 1; i++) {
      const [lon1, lat1] = coords[i];
      const [lon2, lat2] = coords[i + 1];
      area += lon1 * lat2 - lon2 * lat1;
    }

    area = Math.abs(area) / 2;

    // Conversion approximative en hectares (degré carré -> m² -> ha)
    // 1 degré ≈ 111 km à l'équateur
    const areaInSquareMeters = area * (111000 * 111000);
    const areaInHectares = areaInSquareMeters / 10000;

    return parseFloat(areaInHectares.toFixed(2));
  };

  // Calcul des statistiques
  const calculateStats = () => {
    const superficieTotale = parcelles.reduce((sum, p) => sum + (parseFloat(p.superficie) || 0), 0);
    
    // Statistiques par culture
    const cultureStats = {};
    parcelles.forEach(p => {
      const culture = p.culture || 'Non spécifié';
      if (!cultureStats[culture]) {
        cultureStats[culture] = { count: 0, superficie: 0 };
      }
      cultureStats[culture].count++;
      cultureStats[culture].superficie += parseFloat(p.superficie) || 0;
    });

    // Trouver la culture dominante
    const cultureDominante = Object.entries(cultureStats)
      .sort((a, b) => b[1].superficie - a[1].superficie)[0];

    return {
      total: parcelles.length,
      superficieTotale: superficieTotale.toFixed(2),
      producteurs: new Set(parcelles.map(p => p.producteurId).filter(Boolean)).size,
      cultureDominante: cultureDominante ? `${cultureDominante[0]} (${cultureDominante[1].superficie.toFixed(2)} ha)` : '—',
      cultures: Object.keys(cultureStats).length,
    };
  };

  const stats = calculateStats();

  const handlePageChange = (event, newPage) => {
    setPage(newPage);
  };

  const handleRowsPerPageChange = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  const handleFormChange = (field, value) => {
    if (field === 'coordonnees') {
      // Calculer automatiquement la superficie si c'est un polygon valide
      const superficie = calculateSuperficie(value);
      setFormData(prev => ({
        ...prev,
        coordonnees: value,
        superficie: superficie > 0 ? superficie.toString() : prev.superficie,
      }));
    } else {
      setFormData(prev => ({
        ...prev,
        [field]: value
      }));
    }
  };

  const resetForm = () => {
    setFormData({
      code: '',
      culture: '',
      superficie: '',
      producteurId: '',
      coordonnees: null,
    });
  };

  const handleCreate = () => {
    resetForm();
    setCreateDialogOpen(true);
  };

  const handleEdit = (parcelle) => {
    setSelectedParcelle(parcelle);
    setFormData({
      code: parcelle.code || '',
      culture: parcelle.culture || '',
      superficie: parcelle.superficie?.toString() || '',
      producteurId: typeof parcelle.producteurId === 'object' ? parcelle.producteurId._id : parcelle.producteurId,
      coordonnees: parcelle.coordonnees || null,
    });
    setEditDialogOpen(true);
  };

  const handleDelete = (parcelle) => {
    setSelectedParcelle(parcelle);
    setDeleteDialogOpen(true);
  };

  const handleSubmitCreate = async () => {
    try {
      await parcellesAPI.create(formData);
      setCreateDialogOpen(false);
      resetForm();
      loadData();
    } catch (error) {
      console.error('Erreur lors de la création:', error);
      setError(handleApiError(error));
    }
  };

  const handleSubmitEdit = async () => {
    try {
      await parcellesAPI.update(selectedParcelle._id, formData);
      setEditDialogOpen(false);
      setSelectedParcelle(null);
      resetForm();
      loadData();
    } catch (error) {
      console.error('Erreur lors de la modification:', error);
      setError(handleApiError(error));
    }
  };

  const handleSubmitDelete = async () => {
    try {
      await parcellesAPI.delete(selectedParcelle._id);
      setDeleteDialogOpen(false);
      setSelectedParcelle(null);
      loadData();
    } catch (error) {
      console.error('Erreur lors de la suppression:', error);
      setError(handleApiError(error));
    }
  };

  const getProducteurName = (producteurId) => {
    const producteur = producteurs.find(p => p._id === producteurId);
    return producteur ? `${producteur.nom} ${producteur.prenom}` : '—';
  };

  const getCultureColor = (culture) => {
    const colors = {
      'Cacao': 'primary',
      'Café': 'secondary',
      'Anacarde (Cajou)': 'success',
      'Hévéa': 'info',
      'Palmier à huile': 'warning',
      'Riz': 'error',
    };
    return colors[culture] || 'default';
  };

  if (loading) {
    return <LoadingSpinner size={60} message="Chargement des parcelles..." />;
  }

  return (
    <Container maxWidth="xl">
      {/* En-tête */}
      <Box mb={4}>
        <Box display="flex" justifyContent="space-between" alignItems="center" mb={2}>
          <Typography variant="h4" component="h1">
            Parcelles Agricoles
          </Typography>
          <Button
            variant="contained"
            startIcon={<AddIcon />}
            onClick={handleCreate}
          >
            Nouvelle parcelle
          </Button>
        </Box>
        
        {/* Statistiques */}
        <Grid container spacing={2} mb={3}>
          <Grid item xs={12} sm={6} md={3}>
            <Card>
              <CardContent sx={{ textAlign: 'center', py: 2 }}>
                <Typography variant="h4" color="primary">
                  {stats.total}
                </Typography>
                <Typography variant="body2" color="textSecondary">
                  Total parcelles
                </Typography>
              </CardContent>
            </Card>
          </Grid>
          <Grid item xs={12} sm={6} md={3}>
            <Card>
              <CardContent sx={{ textAlign: 'center', py: 2 }}>
                <Typography variant="h4" color="success.main">
                  {stats.superficieTotale} ha
                </Typography>
                <Typography variant="body2" color="textSecondary">
                  Superficie totale
                </Typography>
              </CardContent>
            </Card>
          </Grid>
          <Grid item xs={12} sm={6} md={3}>
            <Card>
              <CardContent sx={{ textAlign: 'center', py: 2 }}>
                <Typography variant="h4" color="info.main">
                  {stats.producteurs}
                </Typography>
                <Typography variant="body2" color="textSecondary">
                  Producteurs
                </Typography>
              </CardContent>
            </Card>
          </Grid>
          <Grid item xs={12} sm={6} md={3}>
            <Card>
              <CardContent sx={{ textAlign: 'center', py: 2 }}>
                <Typography variant="h4" color="warning.main">
                  {stats.cultures}
                </Typography>
                <Typography variant="body2" color="textSecondary">
                  Types de cultures
                </Typography>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </Box>

      {/* Barre de recherche */}
      <Box mb={3}>
        <Grid container spacing={2}>
          <Grid item xs={12} md={4}>
            <TextField
              fullWidth
              placeholder="Rechercher par code ou culture..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              InputProps={{
                startAdornment: <SearchIcon sx={{ mr: 1, color: 'text.secondary' }} />
              }}
            />
          </Grid>
          <Grid item xs={12} md={4}>
            <FormControl fullWidth>
              <InputLabel>Filtrer par producteur</InputLabel>
              <Select
                value={producteurFilter}
                onChange={(e) => setProducteurFilter(e.target.value)}
                label="Filtrer par producteur"
              >
                <MenuItem value="">Tous les producteurs</MenuItem>
                {producteurs.map((p) => (
                  <MenuItem key={p._id} value={p._id}>
                    {p.nom} {p.prenom}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
          </Grid>
          <Grid item xs={12} md={4}>
            <FormControl fullWidth>
              <InputLabel>Filtrer par culture</InputLabel>
              <Select
                value={cultureFilter}
                onChange={(e) => setCultureFilter(e.target.value)}
                label="Filtrer par culture"
              >
                <MenuItem value="">Toutes les cultures</MenuItem>
                {typesCulture.map((c) => (
                  <MenuItem key={c} value={c}>
                    {c}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
          </Grid>
        </Grid>
      </Box>

      {/* Messages d'erreur */}
      {error && (
        <Box mb={2}>
          <Typography variant="body1" color="error">
            Erreur : {error}
          </Typography>
        </Box>
      )}

      {/* Tableau */}
      <Paper>
        <TableContainer>
          <Table>
            <TableHead>
              <TableRow>
                <TableCell>Code</TableCell>
                <TableCell>Culture</TableCell>
                <TableCell>Superficie (ha)</TableCell>
                <TableCell>Producteur</TableCell>
                <TableCell align="center">Actions</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {filteredParcelles.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={5} align="center">
                    <Typography variant="body2" color="textSecondary" sx={{ py: 4 }}>
                      {searchTerm || producteurFilter || cultureFilter ? 'Aucune parcelle trouvée' : 'Aucune donnée'}
                    </Typography>
                  </TableCell>
                </TableRow>
              ) : (
                filteredParcelles
                  .slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage)
                  .map((parcelle) => (
                    <TableRow key={parcelle._id} hover>
                      <TableCell>
                        <Box display="flex" alignItems="center">
                          <MapIcon sx={{ mr: 1, color: 'primary.main' }} />
                          <Typography variant="body1" fontWeight="medium">
                            {parcelle.code || '—'}
                          </Typography>
                        </Box>
                      </TableCell>
                      <TableCell>
                        {parcelle.culture ? (
                          <Chip
                            label={parcelle.culture}
                            size="small"
                            color={getCultureColor(parcelle.culture)}
                          />
                        ) : '—'}
                      </TableCell>
                      <TableCell>
                        <Box display="flex" alignItems="center">
                          <StraightenIcon sx={{ mr: 0.5, fontSize: 16, color: 'text.secondary' }} />
                          {parcelle.superficie ? `${parcelle.superficie} ha` : '—'}
                        </Box>
                      </TableCell>
                      <TableCell>
                        <Box display="flex" alignItems="center">
                          <AgricultureIcon sx={{ mr: 0.5, fontSize: 16, color: 'text.secondary' }} />
                          {getProducteurName(parcelle.producteurId)}
                        </Box>
                      </TableCell>
                      <TableCell align="center">
                        <Tooltip title="Modifier">
                          <IconButton size="small" onClick={() => handleEdit(parcelle)}>
                            <EditIcon />
                          </IconButton>
                        </Tooltip>
                        <Tooltip title="Supprimer">
                          <IconButton size="small" color="error" onClick={() => handleDelete(parcelle)}>
                            <DeleteIcon />
                          </IconButton>
                        </Tooltip>
                      </TableCell>
                    </TableRow>
                  ))
              )}
            </TableBody>
          </Table>
        </TableContainer>
        
        <TablePagination
          rowsPerPageOptions={[10, 25, 50, 100]}
          component="div"
          count={filteredParcelles.length}
          rowsPerPage={rowsPerPage}
          page={page}
          onPageChange={handlePageChange}
          onRowsPerPageChange={handleRowsPerPageChange}
          labelRowsPerPage="Lignes par page:"
        />
      </Paper>

      {/* FAB */}
      <Fab
        color="primary"
        aria-label="add"
        sx={{ position: 'fixed', bottom: 16, right: 16 }}
        onClick={handleCreate}
      >
        <AddIcon />
      </Fab>

      {/* Dialog de création */}
      <Dialog open={createDialogOpen} onClose={() => setCreateDialogOpen(false)} maxWidth="md" fullWidth>
        <DialogTitle>Nouvelle parcelle</DialogTitle>
        <DialogContent>
          <Grid container spacing={2} sx={{ mt: 1 }}>
            <Grid item xs={12} md={6}>
              <TextField
                fullWidth
                label="Code parcelle"
                value={formData.code}
                onChange={(e) => handleFormChange('code', e.target.value)}
                required
              />
            </Grid>
            <Grid item xs={12} md={6}>
              <FormControl fullWidth required>
                <InputLabel>Culture</InputLabel>
                <Select
                  value={formData.culture}
                  onChange={(e) => handleFormChange('culture', e.target.value)}
                  label="Culture"
                >
                  {typesCulture.map((c) => (
                    <MenuItem key={c} value={c}>
                      {c}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
            <Grid item xs={12} md={6}>
              <TextField
                fullWidth
                label="Superficie (hectares)"
                type="number"
                value={formData.superficie}
                onChange={(e) => handleFormChange('superficie', e.target.value)}
                required
                inputProps={{ step: '0.01', min: '0' }}
                helperText="Calculée automatiquement depuis le polygon ou saisie manuelle"
              />
            </Grid>
            <Grid item xs={12} md={6}>
              <FormControl fullWidth required>
                <InputLabel>Producteur</InputLabel>
                <Select
                  value={formData.producteurId}
                  onChange={(e) => handleFormChange('producteurId', e.target.value)}
                  label="Producteur"
                >
                  {producteurs.map((p) => (
                    <MenuItem key={p._id} value={p._id}>
                      {p.nom} {p.prenom}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
            <Grid item xs={12}>
              <GeoJSONInput
                value={formData.coordonnees}
                onChange={(value) => handleFormChange('coordonnees', value)}
                geometryType="Polygon"
                label="Délimitation de la parcelle (Polygon GeoJSON)"
                helperText="Dessinez le contour de la parcelle. La superficie sera calculée automatiquement."
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setCreateDialogOpen(false)}>Annuler</Button>
          <Button 
            onClick={handleSubmitCreate} 
            variant="contained"
            disabled={!formData.code || !formData.culture || !formData.producteurId || !formData.superficie}
          >
            Créer
          </Button>
        </DialogActions>
      </Dialog>

      {/* Dialog de modification */}
      <Dialog open={editDialogOpen} onClose={() => setEditDialogOpen(false)} maxWidth="md" fullWidth>
        <DialogTitle>Modifier la parcelle</DialogTitle>
        <DialogContent>
          <Grid container spacing={2} sx={{ mt: 1 }}>
            <Grid item xs={12} md={6}>
              <TextField
                fullWidth
                label="Code parcelle"
                value={formData.code}
                onChange={(e) => handleFormChange('code', e.target.value)}
                required
              />
            </Grid>
            <Grid item xs={12} md={6}>
              <FormControl fullWidth required>
                <InputLabel>Culture</InputLabel>
                <Select
                  value={formData.culture}
                  onChange={(e) => handleFormChange('culture', e.target.value)}
                  label="Culture"
                >
                  {typesCulture.map((c) => (
                    <MenuItem key={c} value={c}>
                      {c}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
            <Grid item xs={12} md={6}>
              <TextField
                fullWidth
                label="Superficie (hectares)"
                type="number"
                value={formData.superficie}
                onChange={(e) => handleFormChange('superficie', e.target.value)}
                required
                inputProps={{ step: '0.01', min: '0' }}
                helperText="Calculée automatiquement depuis le polygon ou saisie manuelle"
              />
            </Grid>
            <Grid item xs={12} md={6}>
              <FormControl fullWidth required>
                <InputLabel>Producteur</InputLabel>
                <Select
                  value={formData.producteurId}
                  onChange={(e) => handleFormChange('producteurId', e.target.value)}
                  label="Producteur"
                >
                  {producteurs.map((p) => (
                    <MenuItem key={p._id} value={p._id}>
                      {p.nom} {p.prenom}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>
            <Grid item xs={12}>
              <GeoJSONInput
                value={formData.coordonnees}
                onChange={(value) => handleFormChange('coordonnees', value)}
                geometryType="Polygon"
                label="Délimitation de la parcelle (Polygon GeoJSON)"
                helperText="Dessinez le contour de la parcelle. La superficie sera calculée automatiquement."
              />
            </Grid>
          </Grid>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setEditDialogOpen(false)}>Annuler</Button>
          <Button 
            onClick={handleSubmitEdit} 
            variant="contained"
            disabled={!formData.code || !formData.culture || !formData.producteurId || !formData.superficie}
          >
            Modifier
          </Button>
        </DialogActions>
      </Dialog>

      {/* Dialog de suppression */}
      <Dialog open={deleteDialogOpen} onClose={() => setDeleteDialogOpen(false)} maxWidth="sm">
        <DialogTitle>Confirmer la suppression</DialogTitle>
        <DialogContent>
          <Typography>
            Êtes-vous sûr de vouloir supprimer la parcelle "{selectedParcelle?.code}" ?
          </Typography>
          <Typography variant="body2" color="error" sx={{ mt: 1 }}>
            Cette action est irréversible.
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setDeleteDialogOpen(false)}>Annuler</Button>
          <Button onClick={handleSubmitDelete} color="error" variant="contained">
            Supprimer
          </Button>
        </DialogActions>
      </Dialog>
    </Container>
  );
};

export default ParcellesListPage;
